# TEX Engine local test stack - optional settings.
# Copy to ".env" (same folder) and change what you need; every value has a default.
#   Windows PowerShell:  Copy-Item .env.example .env; notepad .env
#   macOS / Linux:       cp .env.example .env    (then edit it with any text editor)
# Save it as plain text (UTF-8 or ANSI). Do not create it with `echo ... > .env` in
# Windows PowerShell 5.1: that writes UTF-16 and then every docker compose command fails.
# LOCAL TESTING ONLY: these defaults are well known. Never expose this stack to a network.
# Keep values in single quotes if they contain # or $ characters.

# Port on your computer: http://localhost:<TEX_PORT>
TEX_PORT=8000
# Interface the port is published on. 127.0.0.1 = this computer only (recommended).
TEX_BIND=127.0.0.1

# Frappe site name (internal; any Host header is served by this site). Fixed by the
# first start: a different value later stops the container with a message.
TEX_SITE=tex.localhost
# Time zone of the site and the demo hotels (they are in Turkiye); first start only
TEX_TIME_ZONE=Europe/Istanbul

# Passwords are applied on the FIRST start only (when the site and database are created).
# To change them later: docker compose down -v (deletes all data) and start again.
# Frappe "Administrator" (Desk at /desk)
ADMIN_PASSWORD=admin
# Demo users revenue@demo.tex, agent@demo.tex, finance@demo.tex, beach.gm@demo.tex
DEMO_PASSWORD='TexDemo#2026'
# MariaDB root password (database container)
DB_ROOT_PASSWORD=tex-local-root

# Only on networks whose proxy re-signs HTTPS (some company networks): remove the "# "
# in front of all three lines and set the path of that network's root CA certificate
# (PEM). Every docker compose command in this folder, `up -d --build` included, then
# hands the certificate to the image build (docker-compose.extra-ca.yml); it is never
# stored in the image. Windows paths may use / or \ (C:/Users/me/company-root-ca.pem).
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.extra-ca.yml
# TEX_EXTRA_CA_FILE=/path/to/company-root-ca.pem
