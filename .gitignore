# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Node / frontend
node_modules/
# a worktree's frontend/node_modules is a symlink, which "node_modules/" does not match
/frontend/node_modules
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Frappe
kamra/public/dist/
# bench links the app's node_modules into its assets, which are kamra/public: a symlink, which a trailing
# slash would not match (2Z, NEW-4)
/kamra/public/node_modules
# written by bench's `yarn install --check-files` in the app root (no dependencies there)
/yarn.lock
*.log

# Local
.DS_Store
.env

# Internal operator plans — keep local only, never publish
PLAN.md
docs/adr-str.md
docs-site/node_modules/
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/

graphify-out/
dump.rdb

# agent worktrees (local only)
.claude/worktrees/
# Playwright E2E output
/e2e-report/
/e2e-results/
frontend/e2e-report/
frontend/test-results/
